        <!-- v1.0.8 -->
        <item>
            <title>Version 1.0.8</title>
            <description><![CDATA[
                <h2>WebRTC Timeout & UX Improvements</h2>
                <ul>
                    <li><strong>Smart Timeouts:</strong> Implemented intelligent timeout logic - 15s when no guests, 45s when guests are present</li>
                    <li><strong>Guest Detection:</strong> Added participant count awareness to avoid unnecessary waiting</li>
                    <li><strong>Connection Status:</strong> Real-time WebRTC connection status indicators in the UI</li>
                    <li><strong>Graceful Recovery:</strong> Added WebRTC signaling restart capability for failed connections</li>
                    <li><strong>Enhanced Logging:</strong> Improved progress tracking and error messaging throughout signaling flow</li>
                    <li><strong>User Feedback:</strong> Clear system messages for connection issues, timeouts, and recovery options</li>
                    <li><strong>Host Detection:</strong> Guests now detect if host leaves the room and fail fast appropriately</li>
                </ul>
            ]]></description>
            <pubDate>Tue, 10 Nov 2025 01:00:00 -0800</pubDate>
            <sparkle:version>1.0.8</sparkle:version>
            <sparkle:shortVersionString>1.0.8</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>13.0</sparkle:minimumSystemVersion>
            <enclosure
                url="https://github.com/orangeapple1272/Redlemon/releases/download/v1.0.8/RedLemon-Installer.dmg"
                length="85548727"
                type="application/octet-stream"
            />
        </item>

        <!-- v1.0.5 -->
        <item>
            <title>Version 1.0.5</title>
            <description><![CDATA[
                <h2>Critical Watch Party Fixes</h2>
                <ul>
                    <li><strong>Database Polling:</strong> Participants sync every 2 seconds</li>
                    <li><strong>Chat Persistence:</strong> Messages saved to database, sync every 1.5 seconds</li>
                    <li><strong>RLS Policies:</strong> Fixed database write permissions</li>
                    <li><strong>Room Auto-Delete:</strong> Rooms properly clean up when host exits</li>
                    <li><strong>User Search:</strong> Can now search for users by username</li>
                    <li><strong>Reliability:</strong> Watch parties work even if WebRTC fails</li>
                </ul>
            ]]></description>
            <pubDate>Fri, 08 Nov 2025 18:30:00 -0800</pubDate>
