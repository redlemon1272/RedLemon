        <!-- v1.0.5 -->
        <item>
            <title>Version 1.0.5</title>
            <description><![CDATA[
                <h2>Critical Watch Party Fixes</h2>
                <ul>
                    <li><strong>Database Polling:</strong> Participants sync every 2 seconds</li>
                    <li><strong>Chat Persistence:</strong> Messages saved to database, sync every 1.5 seconds</li>
                    <li><strong>RLS Policies:</strong> Fixed database write permissions</li>
                    <li><strong>Room Auto-Delete:</strong> Rooms properly clean up when host exits</li>
                    <li><strong>User Search:</strong> Can now search for users by username</li>
                    <li><strong>Reliability:</strong> Watch parties work even if WebRTC fails</li>
                </ul>
            ]]></description>
            <pubDate>Fri, 08 Nov 2025 18:30:00 -0800</pubDate>
